{
  "name": "chronicle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"cargo run --manifest-path server/Cargo.toml\" \"vite\"",
    "dev:backend": "cargo run --manifest-path server/Cargo.toml",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "build:release": "npm run build && cargo build --release --manifest-path server/Cargo.toml",
    "test": "cargo test --manifest-path server/Cargo.toml",
    "test:frontend": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
